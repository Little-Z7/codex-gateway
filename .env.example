# Generate a production value with: openssl rand -hex 32
CODEX_GATEWAY_CONFIG_SECRET=replace-with-a-stable-random-secret

# Port the Gateway listens on; the UI, APIs and same-origin browser previews are all served
# from this single port.
CODEX_GATEWAY_PORT=3000

# Codex CLI version baked into the user workspace image. bootstrap.sh fills this in from
# server/utils/gateway/infra/codex/codex-version.ts automatically.
CODEX_CLI_VERSION=

# Container provisioning ("docker" to enable, "off" to disable)
CODEX_GATEWAY_PROVISIONING=docker
CODEX_GATEWAY_USER_IMAGE=codex-gateway-user:latest
CODEX_GATEWAY_DOCKER_NETWORK=codex-gateway
CODEX_GATEWAY_DOCKER_SOCKET=/var/run/docker.sock

# Host-side directory holding the shared Codex login (auth.json). Mounted into every user
# container at /srv/codex-auth. See deploy/scripts/codex-login.sh.
CODEX_GATEWAY_SHARED_AUTH_DIR=./data/shared-auth
# Host-side directory shared read/write into every user container at /data/shared. All user
# containers run as uid 1000, so files written there are mutually writable across users.
CODEX_GATEWAY_SHARED_DATA_DIR=./data/shared

CODEX_GATEWAY_USER_CONTAINER_PREFIX=codex-user-
# Optional resource limits applied to every user container.
#CODEX_GATEWAY_USER_CONTAINER_MEMORY=4g
#CODEX_GATEWAY_USER_CONTAINER_CPUS=2
# Per-container PID cgroup limit (fork-bomb guard). 0 means unlimited. Default 512 is generous for
# an interactive shell + Codex agent + a handful of subprocesses.
#CODEX_GATEWAY_USER_CONTAINER_PIDS=512
# Puts every user container's cgroup under this systemd slice (systemd cgroup driver only; must
# end in ".slice", e.g. codex-gateway-users.slice) so the host can cap their *aggregate* resource
# usage with `systemctl set-property <slice> MemoryMax=... CPUQuota=... TasksMax=...` -- protects
# other services on a shared host even when individual container limits above are generous or
# unset. Unset by default (no cgroup parent applied). See deploy/README.zh-CN.md's "安全加固".
#CODEX_GATEWAY_USER_CONTAINER_CGROUP_PARENT=codex-gateway-users.slice
# Codex sandbox mode inside user containers; the container itself is the isolation boundary.
CODEX_GATEWAY_SANDBOX_MODE=danger-full-access

# Model path for user containers. Two mutually exclusive options:
#  - openai (default): members share the ChatGPT login created by deploy/scripts/codex-login.sh
#    (CODEX_GATEWAY_SHARED_AUTH_DIR).
#  - custom: every container uses one shared API-key provider instead — no shared login needed.
#    Provider id must match [a-z0-9_-]+; wire_api is "responses" (chat was removed in Codex
#    0.154). The API key is visible via `docker inspect` on the user containers — internal
#    trusted topology only. web_search defaults to "disabled" for custom providers.
#CODEX_GATEWAY_MODEL_PROVIDER=custom
#CODEX_GATEWAY_MODEL_PROVIDER_ID=ollama-cloud
#CODEX_GATEWAY_MODEL_PROVIDER_NAME=Ollama Cloud
#CODEX_GATEWAY_MODEL_PROVIDER_BASE_URL=https://ollama.com/v1
#CODEX_GATEWAY_MODEL_PROVIDER_API_KEY=
#CODEX_GATEWAY_MODEL_PROVIDER_WIRE_API=responses
#CODEX_GATEWAY_MODEL=gpt-oss:120b
#CODEX_GATEWAY_WEB_SEARCH=disabled

# Optional outbound HTTP(S) proxy, for deployments that can only reach the internet through one
# (e.g. Clash/mihomo). Covers the Gateway's own downloads (Codex standalone release archives, the
# npm "latest version" check, Bark push) and Codex's model-API calls inside every user container.
# Unset by default -- behavior is unchanged. CODEX_GATEWAY_OUTBOUND_NO_PROXY adds extra
# comma-separated hostnames/IPs that should bypass the proxy (localhost/127.0.0.1/::1 always
# bypass it already); it does not support CIDR ranges, only exact hosts/domain suffixes.
#CODEX_GATEWAY_OUTBOUND_PROXY=http://127.0.0.1:7890
#CODEX_GATEWAY_OUTBOUND_NO_PROXY=

# json-file log rotation inside user containers (Docker json-file driver).
#CODEX_GATEWAY_USER_CONTAINER_LOG_MAX_SIZE=10m
#CODEX_GATEWAY_USER_CONTAINER_LOG_MAX_FILES=3

# User volume size (bytes) above which the admin console flags the workspace as over
# the disk threshold (default 20 GiB).
#CODEX_GATEWAY_VOLUME_WARN_BYTES=21474836480

# Login lockout defaults. These are fallbacks — the admin console 安全 settings card
# persists overrides to the database, which take precedence at runtime.
#CODEX_GATEWAY_LOGIN_MAX_FAILURES=5
#CODEX_GATEWAY_LOGIN_LOCKOUT_MINUTES=15
